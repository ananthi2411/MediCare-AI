# S3 Storage Config
S3_BUCKET=medicare-reports-2026
AWS_REGION=us-east-1

# PostgreSQL RDS Config
RDS_ENDPOINT=your-rds-endpoint.amazonaws.com
RDS_DB=medicare_db
RDS_USER=postgres
RDS_PASS=password
RDS_PORT=5432

# DynamoDB Config
DYNAMO_TABLE=CriticalAlerts

# OpenAI API Key
OPENAI_API_KEY=your-openai-api-key-here

# Server Settings
HOST=0.0.0.0
PORT=8000
